# Postgres connection string. Added automatically by the Neon integration on Vercel.
# Leave unset locally to use an embedded database stored in ./.pglite
DATABASE_URL=

# Long random string used to sign session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Used by Parton from Phase 3 onwards.
ANTHROPIC_API_KEY=

# Lets Frontier create each project's public GitHub repository and keep its README up to date. A fine-grained
# personal access token with access to all repositories and read and write permission for Administration and Contents.
GITHUB_TOKEN=
